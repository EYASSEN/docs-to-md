# Docs to MD - files that never go to GitHub (Cleanup1)
# The portable zip goes to GitHub Releases. Only synthetic test fixtures are published.

# Python and tools
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Build and release output
build/
build-cache/
dist/
release/
vendor/
java/
data/
test-results/
test-work/
reports/
*.log

# Backups and update packages from development
*.bak-*
*-backup-*/
DocsToMD-*/
*.zip
*.rar
*.7z
Files to md.zip

# Personal notes and one-off maintenance scripts
Codex_Portable_Document_Converter_Prompt.md
fix_progress_permission.py
fix_test_fixture.py
rename_exe.py
# Written during development; review its content before deciding to publish it.
ACCEPTANCE_REPORT.md

# Conversion output
*_md/
test_md/
.foldertomd-data*/

# Documents are ignored by default ...
*.pdf
*.doc
*.docx
*.docm
*.xls
*.xlsx
*.xlsm
*.ppt
*.pptx
*.pptm

# ... except these SYNTHETIC fixtures (generated by tests/make_fixtures.py and
# scripts/make_legacy_fixtures.py from invented content, no user documents).
!tests/fixtures/arabic_table.pdf
!tests/fixtures/hidden-ocr.pdf
!tests/fixtures/pdf/
!tests/fixtures/pdf/hidden-ocr.pdf
!tests/fixtures/legacy/
!tests/fixtures/legacy/*

# PRIVATE fixtures: crops, traces and ground truth taken from the owner's work
# documents. Keep them on the owner's PC only. Tests that need them skip themselves
# when the files are missing (see tests/conftest.py).
tests/fixtures/update*/
